# Copy this file to .env and fill in values

# Path to the local ChromaDB directory
CHROMA_DB_PATH=./chroma_db

# Path to the raw dataset
DATASET_PATH=./dataset/fra_cleaned.csv

# Path to processed chunks
CHUNKS_PATH=./data/chunks.jsonl

# Path to feedback log
FEEDBACK_LOG_PATH=./data/feedback_log.jsonl

# Ollama model tag (inference)
# Options: gemma2:2b | llama3.2:3b | tinyllama | mistral
OLLAMA_MODEL=gemma4:e4b

# Ollama server URL
# Docker Compose: http://ollama:11434
# Local (no Docker): http://localhost:11434
OLLAMA_BASE_URL=http://ollama:11434

# HuggingFace model ID — only needed for fine-tuning (src/finetune/)
SLM_MODEL_ID=google/gemma-2-2b-it

# HuggingFace token — only needed for fine-tuning with gated models
HUGGINGFACE_TOKEN=

# FastAPI backend URL (used by Next.js frontend)
NEXT_PUBLIC_API_URL=http://localhost:8000

# PostgreSQL (Phase 1)
# Docker Compose: postgresql://nosknows:nosknows@postgres:5432/nosknows
# Local (no Docker): postgresql://nosknows:nosknows@localhost:5432/nosknows
POSTGRES_URL=postgresql://nosknows:nosknows@postgres:5432/nosknows
POSTGRES_PASSWORD=nosknows
